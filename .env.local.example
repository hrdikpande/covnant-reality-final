# ==============================================
# Covnant Reality - Environment Variables
# ==============================================
# Copy this file to .env and fill in your values.
# NEVER commit the actual .env file to version control.
# ==============================================

# Supabase Project URL (public — safe for client-side)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase Anon Key (public — safe for client-side, restricted by RLS)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Supabase Service Role Key (SECRET — server/scripts only, bypasses RLS)
# Only needed for admin scripts like generatePropertyBlogs.mjs
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Canonical site URL — MUST be the non-www host. www.covnantreality.com
# 301-redirects to covnantreality.com; setting this to the www host here
# (or in Netlify's dashboard) reintroduces "3XX redirect in sitemap" errors.
NEXT_PUBLIC_BASE_URL=https://covnantreality.com
